# Copy to .env (gitignored) and fill in. dbt-mcp reads it through .mcp.json.
# Claude Code itself also needs DBT_PROJECT_DIR, SNOWFLAKE_ACCOUNT_URL and
# SNOWFLAKE_PAT exported in the shell it starts from.

# Both paths. Full paths, not relative ones.
# GOTCHA, confirmed live: dbt v2 auto-loads this .env file itself, and it
# also reads DBT_PROJECT_DIR as the built-in env fallback for its own
# --project-dir flag. Leave this as a placeholder (or point it elsewhere)
# and every local `dbt` command in this repo silently targets the wrong
# directory and fails with a permission error creating logs/ there.
DBT_PROJECT_DIR=/absolute/path/to/jaffle_shop
DBT_PATH=/absolute/path/to/dbt

# Path A (Starter or above): dbt Semantic Layer tools in dbt MCP.
DBT_HOST=abc123.us1.dbt.com
DBT_TOKEN=
DBT_PROD_ENV_ID=

# Path B (Developer plan): no platform APIs. Delete the three lines above and
# uncomment these; governed metrics then come from the Snowflake MCP server.
# DISABLE_SEMANTIC_LAYER=true
# DISABLE_DISCOVERY=true
# DISABLE_ADMIN_API=true

# bridge/qlik/sync.py only. Tenant URL is a bare host, like
# mytenant.us.qlikcloud.com -- no scheme, no trailing slash. App ID is the
# GUID in the app's URL. API key comes from the Management Console (gear
# icon) > API keys > Generate new key -- shown once, never committed.
QLIK_TENANT_URL=
QLIK_APP_ID=
QLIK_API_KEY=
